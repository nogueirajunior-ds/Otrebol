# ---------- Public ----------
# WhatsApp number in international format, digits only (e.g. 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=5511989172222
# Canonical site URL (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.otrebol.com

# ---------- Lead capture (server only) ----------
# Option A: e-mail through Resend (https://resend.com)
RESEND_API_KEY=
LEAD_FROM_EMAIL="Otrebol Leads <leads@your-verified-domain.com>"
LEAD_TO_EMAIL=comercial@otrebol.com

# Option B: any webhook (Zapier, Make, n8n, HubSpot, RD Station, a WhatsApp gateway...)
# Receives the lead as JSON via POST.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
